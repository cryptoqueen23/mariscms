---
import { site } from "../site.config";
const {title=site.name,description=site.description}=Astro.props;
---
<!doctype html><html lang={site.locale}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><title>{title}</title><style is:global>
:root{--ink:#101820;--paper:#f7f4ed;--rule:#c8c1b4;--accent:#164e80;--muted:#625f59}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Georgia,serif}a{color:inherit;text-decoration:none}.wrap{width:min(1180px,92%);margin:auto}.top{border-bottom:1px solid var(--rule);font:12px Arial,sans-serif;letter-spacing:.08em;padding:9px 0}.mast{padding:28px 0 18px;text-align:center}.mast a{font-size:clamp(38px,7vw,76px);font-weight:900;letter-spacing:-.055em}.tag{font:13px Arial,sans-serif;color:var(--muted);letter-spacing:.13em;text-transform:uppercase}.nav{border-block:3px double var(--ink);overflow:auto}.nav .wrap{display:flex;gap:28px;padding:12px 0;white-space:nowrap;font:700 13px Arial,sans-serif;text-transform:uppercase}.nav a:hover{color:var(--accent)}main{padding:30px 0 70px}.label{font:700 11px Arial,sans-serif;text-transform:uppercase;letter-spacing:.14em;color:var(--accent)}h1,h2,h3{line-height:1.02;margin:.25em 0}.dek{font-size:18px;line-height:1.45;color:#484641}.meta{font:12px Arial,sans-serif;color:var(--muted)}.rule-title{border-bottom:2px solid var(--ink);padding-bottom:8px;margin-top:40px;font-size:22px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.card{border-top:1px solid var(--rule);padding-top:14px}.card h3{font-size:25px}.footer{border-top:3px double var(--ink);padding:28px 0 50px;font:13px Arial,sans-serif;color:var(--muted)}article.prose{max-width:760px;margin:auto}.prose h1{font-size:clamp(42px,7vw,72px)}.prose .body{font-size:19px;line-height:1.7}.brief{display:grid;grid-template-columns:90px 1fr;gap:18px;border-top:1px solid var(--rule);padding:16px 0}@media(max-width:760px){.cards{grid-template-columns:1fr}.mast{text-align:left}.hero{grid-template-columns:1fr!important}.brief{grid-template-columns:1fr}}
</style></head><body><div class="top"><div class="wrap">{site.topLine}</div></div><header class="mast wrap"><a href="/">{site.name}</a><div class="tag">{site.tagline}</div></header><nav class="nav"><div class="wrap"><a href="/">Latest</a><a href="/section/local">Local</a><a href="/section/government">Government</a><a href="/section/schools">Schools</a><a href="/section/business">Business</a><a href="/section/community">Community</a><a href="/section/opinion">Opinion</a><a href="/live-wire">Live Wire</a><a href="/admin/">CMS</a></div></nav><main class="wrap"><slot/></main><footer class="footer"><div class="wrap"><strong>{site.name}</strong><br>Powered by MariCMS News Recipe.</div></footer></body></html>