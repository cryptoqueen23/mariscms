---
import Base from "../../layouts/Base.astro";import {getCollection,render} from "astro:content";
export async function getStaticPaths(){return (await getCollection("features")).map(s=>({params:{id:s.id},props:{s}}))}
const {s}=Astro.props;const {Content}=await render(s);
---
<Base title={s.data.seoTitle||s.data.title} description={s.data.seoDescription||s.data.dek}><article class="prose"><div class="kicker">{s.data.department} · {s.data.contentType}</div><h1>{s.data.title}</h1><p class="dek">{s.data.dek}</p><p class="meta">By {s.data.author} · {s.data.publishDate.toLocaleDateString()}</p><hr><div class="body"><Content/></div>{s.data.disclosure&&<p class="meta">Disclosure: {s.data.disclosure}</p>}</article></Base>