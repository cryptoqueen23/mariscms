---
import { site } from "../../site.config";
const { title = site.name, description = site.description } = Astro.props;
---
<!doctype html>
<html lang={site.locale}>
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content={description}><title>{title}</title>
<style is:global>
:root{--ink:#161412;--paper:#f7f3ed;--cream:#eee7dc;--wine:#7d263f;--muted:#746d65;--line:#cfc5b9;--serif:Georgia,"Times New Roman",serif;--sans:Arial,Helvetica,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink)}a{color:inherit;text-decoration:none}.wrap{width:min(1340px,92vw);margin:auto}
.top{font:700 9px var(--sans);letter-spacing:.22em;text-align:center;padding:10px 0;border-bottom:1px solid var(--line);text-transform:uppercase}
.mast{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:27px 0 23px}.mast .issue{font:10px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}.mast .issue:last-child{text-align:right}.mast a{font:900 clamp(52px,9vw,118px)/.72 var(--serif);letter-spacing:-.085em}.tag{text-align:center;font:10px var(--sans);letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin-top:17px}
.nav{border-block:1px solid var(--ink);overflow:auto}.nav .wrap{display:flex;justify-content:center;gap:24px;padding:11px 0;white-space:nowrap}.nav a{font:700 9px var(--sans);letter-spacing:.11em;text-transform:uppercase}
main{padding:30px 0 90px}.hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(270px,.55fr);min-height:570px;background:var(--cream);position:relative;overflow:hidden}.hero-copy{padding:58px 7% 55px;display:flex;flex-direction:column;justify-content:flex-end}.eyebrow{font:700 10px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--wine)}.hero h1{font:700 clamp(48px,7vw,104px)/.86 var(--serif);letter-spacing:-.045em;margin:14px 0 20px;max-width:850px}.dek{font:18px/1.48 var(--serif);color:#4e4944;max-width:650px}.meta{font:9px var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.hero-art{min-height:570px;background:linear-gradient(135deg,#d7c5b2,#b99b8b 55%,#80626b);position:relative}.hero-art:after{content:"XX";position:absolute;right:-25px;bottom:-80px;font:900 300px/1 var(--serif);color:rgba(255,255,255,.22);letter-spacing:-.1em}.hero-note{position:absolute;right:25px;top:25px;width:125px;height:125px;border:1px solid rgba(255,255,255,.8);border-radius:50%;display:grid;place-items:center;text-align:center;color:#fff;font:700 9px var(--sans);letter-spacing:.1em;text-transform:uppercase}
.rule{display:flex;justify-content:space-between;align-items:baseline;border-bottom:2px solid var(--ink);margin:62px 0 22px;padding-bottom:9px}.rule h2{font:700 38px/1 var(--serif);margin:0;letter-spacing:-.02em}.rule span{font:700 9px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.latest{display:grid;grid-template-columns:1.25fr .75fr .75fr;gap:25px}.story{border-top:1px solid var(--line);padding-top:13px}.story:first-child{border-top:0}.story h3{font:700 32px/1.02 var(--serif);margin:8px 0}.story.small h3{font-size:25px}.story p{font:16px/1.45 var(--serif);color:#514c47}.story-image{height:190px;margin-bottom:15px;background:linear-gradient(135deg,#d8c9ba,#aa8990)}.story-image.tall{height:270px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:35px;margin-top:65px}.package{border-top:5px solid var(--ink);padding-top:13px}.package h2{font:700 clamp(40px,5vw,68px)/.9 var(--serif);margin:8px 0}.package p{font:17px/1.5 var(--serif);color:#514c47}.package .num{font:700 9px var(--sans);letter-spacing:.15em;color:var(--wine);text-transform:uppercase}
.departments{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}.departments a{padding:18px 12px;border-right:1px solid var(--line);font:700 11px var(--sans);text-transform:uppercase;letter-spacing:.08em}.departments a:nth-child(5n){border-right:0}
.footer{margin-top:70px;border-top:4px double var(--ink);padding:30px 0 70px;font:10px/1.7 var(--sans);letter-spacing:.04em;color:var(--muted)}
article.prose{max-width:850px;margin:auto}.prose h1{font:700 clamp(50px,8vw,100px)/.86 var(--serif);letter-spacing:-.045em;margin:12px 0 18px}.prose .body{font:19px/1.8 var(--serif)}.prose .body h2{font:38px/1 var(--serif)}.prose .body blockquote{border-left:3px solid var(--wine);margin-left:0;padding-left:22px}
@media(max-width:800px){.mast{grid-template-columns:1fr;text-align:center}.mast .issue{display:none}.hero{grid-template-columns:1fr}.hero-art{min-height:310px;order:-1}.hero-copy{min-height:390px;padding:40px 7%}.latest,.split{grid-template-columns:1fr}.departments{grid-template-columns:repeat(2,1fr)}.departments a:nth-child(5n){border-right:1px solid var(--line)}.departments a:nth-child(2n){border-right:0}}
</style>
</head>
<body>
<div class="top"><div class="wrap">{site.topLine}</div></div>
<header class="mast wrap"><div class="issue">Vol. 01 · 2026</div><div><a href="/">{site.name}</a><div class="tag">{site.tagline}</div></div><div class="issue">A magazine for women</div></header>
<nav class="nav"><div class="wrap">{site.departments.map(d=><a href={`/department/${d.toLowerCase().replaceAll(" ","-").replaceAll("&","and")}`}>{d}</a>)}</div></nav>
<main class="wrap"><slot /></main>
<footer class="footer"><div class="wrap"><strong>{site.name}</strong> · {site.tagline}<br><br>Editorial content, commerce and sponsored material are clearly distinguished.</div></footer>
</body></html>