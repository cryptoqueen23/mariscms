---
import Base from "../layouts/Base.astro";import {getCollection} from "astro:content";
const stories=(await getCollection("stories")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const hero=stories.find(s=>s.data.featured)||stories[0];const rest=stories.filter(s=>s.id!==hero?.id);
---
<Base title="The Local Ledger"><section class="hero" style="display:grid;grid-template-columns:2fr 1fr;gap:34px;border-bottom:1px solid var(--rule);padding-bottom:30px"><div><div class="label">{hero?.data.section}</div><h1 style="font-size:clamp(42px,6vw,70px)"><a href={`/stories/${hero?.id}/`}>{hero?.data.title}</a></h1><p class="dek">{hero?.data.dek}</p><div class="meta">By {hero?.data.author} • {hero?.data.publishDate.toLocaleDateString()}</div></div><aside><div class="label">Newsroom note</div><h2>A publication starter built for real local reporting</h2><p class="dek">Replace this demo identity, sections and stories with the client's publication. The editorial structure stays reusable.</p></aside></section><h2 class="rule-title">Latest</h2><div class="cards">{rest.map(s=><article class="card"><div class="label">{s.data.section}</div><h3><a href={`/stories/${s.id}/`}>{s.data.title}</a></h3><p>{s.data.dek}</p><div class="meta">By {s.data.author}</div></article>)}</div></Base>